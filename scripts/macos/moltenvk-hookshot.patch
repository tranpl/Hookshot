+// (hookshot) A pipeline barrier outside a render pass ended the current Metal encoder, and the next one waited on its
+// fence: a compute encoder a dispatch, the GPU drained between each (Hookshot puts a barrier before every dispatch, and the
+// mesh fallback three around each draw's two). With a compute encoder open, the barrier is a memory barrier in it, the
+// encoder stays, and the waits of later encoders name the fence it updates when it ends (getBarrierStageFence: the next
+// slot when its stage is dirty). MVK_HOOKSHOT_SPLIT_COMPUTE=1: as before.
+static bool wantsSeparateComputeEncoder(MVKCommandUse use);
+bool MVKCommandEncoder::setBarrierInOpenCompute(uint64_t sourceStageMask, uint64_t destStageMask) {
+	static const bool split = getenv("MVK_HOOKSHOT_SPLIT_COMPUTE") && atoi(getenv("MVK_HOOKSHOT_SPLIT_COMPUTE")) != 0;
+	if (split || !_mtlComputeEncoder || _mtlRenderEncoder || _mtlBlitEncoder) return false;
+	const MVKBarrierStage open = commandUseToBarrierStage(_mtlComputeEncoderUse);
+	if (open == kMVKBarrierStageNone || wantsSeparateComputeEncoder(_mtlComputeEncoderUse)) return false;
+	[_mtlComputeEncoder memoryBarrierWithScope: MTLBarrierScopeBuffers | MTLBarrierScopeTextures];
+	auto &fenceSlots = _pEncodingContext->fenceSlots;
+	uint32_t openSlot = fenceSlots.update[open];
+	if (mvkAreAllFlagsEnabled(fenceSlots.updateDirtyBits, 1 << open)) {
+		openSlot = (openSlot + 1) % kMVKBarrierFenceCount;
+		if (openSlot == 0) openSlot = 1;
+	}
+	for (int i = 0; i < kMVKBarrierStageCount; ++i) {
+		if (!mvkIsAnyFlagEnabled(sourceStageMask, 1ull << i)) continue;
+		const uint32_t slot = i == open ? openSlot : fenceSlots.update[i];
+		for (int j = 0; j < kMVKBarrierStageCount; ++j) {
+			if (!mvkIsAnyFlagEnabled(destStageMask, 1ull << j)) continue;
+			fenceSlots.wait[j][i] = slot;
+		}
+		fenceSlots.wait[i][i] = slot;
+		if (i != open) mvkEnableFlags(fenceSlots.updateDirtyBits, 1 << i);
+	}
+	return true;
+}
